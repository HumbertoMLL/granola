# Copiar a apps/web/.env.local

# Base de datos (Neon)
DATABASE_URL=postgresql://user:pass@host/granola?sslmode=require

# Better Auth
# Genera el secret con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth (opcional en dev; sin estas vars el botón de Google no funciona).
# Redirect URI autorizado: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Calendar: AES-256-GCM. Genera 32 bytes base64 con: openssl rand -base64 32
# Guarda la misma llave en web y jobs; cambiarla invalida las conexiones existentes.
GOOGLE_TOKEN_ENC_KEY=

# WhatsApp Cloud API (Meta)
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=

# Origen público de la app (sin slash final). Única variable para el dominio público:
# links de WhatsApp, canonical/OG de /[slug], return/refresh URLs de Stripe Connect,
# notification_url de Mercado Pago y /pago/[id]. Si falta, se usa BETTER_AUTH_URL.
# (NEXT_PUBLIC_SITE_URL está deprecada: no usarla.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Connect (cuenta plataforma). Webhook: https://<dominio>/api/webhooks/stripe
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded,
#          checkout.session.async_payment_failed, checkout.session.expired, account.updated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mercado Pago (cuenta Granola; split al nutri es F1.5). Webhook: https://<dominio>/api/webhooks/mercadopago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Inngest (en dev local no hacen falta: el SDK habla con el dev server)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Inngest dev: npx inngest-cli@latest dev -u http://localhost:3100/api/inngest

# Archivos (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=granola
# Dominio público del bucket (sin slash final), p. ej. https://media.granola.app
R2_PUBLIC_URL=

# Email transaccional (sin API key: dry run; con key: remitente de un dominio verificado)
EMAIL_FROM="Granola <hola@granola.app>"
RESEND_API_KEY=

# Analítica
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=

# Solo desarrollo local con docker-compose.local.yml (no poner en Vercel)
NEON_LOCAL_PROXY=
NEON_LOCAL_PG_HOST=
# Opcional: versión de Graph API (default v21.0)
WA_GRAPH_VERSION=

# Rate limit distribuido (Upstash Redis REST, sin SDK).
# Con ambas vars se usa Redis; sin alguna se usa memoria (warning en producción).
# Error/timeout de 500 ms: fail-open, permite continuar y registra un aviso.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
