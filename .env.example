# Copiar a apps/web/.env.local

# Base de datos (Neon)
DATABASE_URL=postgresql://user:pass@host/granola?sslmode=require

# Better Auth
# Genera el secret con: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Google OAuth (opcional en dev; sin estas vars el botón de Google no funciona).
# Redirect URI autorizado: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# WhatsApp Cloud API (Meta)
WA_PHONE_NUMBER_ID=
WA_BUSINESS_ACCOUNT_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=
WA_APP_SECRET=

# Origen público de la app (sin slash final). Lo usan pagos para armar
# return/refresh URLs de Stripe Connect, notification_url de Mercado Pago y /pago/[id].
# Si falta, se usa BETTER_AUTH_URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe Connect (cuenta plataforma). Webhook: https://<dominio>/api/webhooks/stripe
# Eventos: checkout.session.completed, checkout.session.async_payment_succeeded,
#          checkout.session.async_payment_failed, checkout.session.expired, account.updated
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Mercado Pago (cuenta Granola; split al nutri es F1.5). Webhook: https://<dominio>/api/webhooks/mercadopago
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Archivos (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=granola

# Email
RESEND_API_KEY=

# Analítica
NEXT_PUBLIC_POSTHOG_KEY=
SENTRY_DSN=
